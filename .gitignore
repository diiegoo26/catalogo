# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (real secrets are NEVER committed)
.env*
.env.local
.env.*.local
!.env.local.example
!.env*.example

# credentials: nunca al repo (el candado real está en .githooks/pre-commit)
*.key
*.p12
*.pfx
*.jks
*.keystore
.pgpass
.npmrc
.netrc
.git-credentials
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SDD workspace (scratch, git-free execution)
/.superpowers/
.vercel

# indice local de CodeGraph (se regenera por checkout)
/.codegraph/

# SUDU import scratch (regenerated by scripts/sudu/extract.py)
scripts/sudu/out/

# Salida del extractor retro (manifest, informe, snapshot de equipos)
/scripts/retro/out/
# Local AI runtime state
.atl/
